# --- Database ---
# URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/oitesla?schema=public"

# --- Security ---
# Secret used for signing JWTs. Change this in production!
JWT_SECRET="supersecretjwtkey123"

# --- Ports & Networking ---
# The port mapping for docker-compose exposed on the host
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432

# The URL the frontend uses to talk to the API. 
# In local development, it hits the port mapped to the host.
NEXT_PUBLIC_API_URL="http://localhost:3001"

